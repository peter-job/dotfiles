[user]
	name = {{ .name }}
	email = {{ .email }}
[advice]
	addEmptyPathspec = false
	statusHints = false
[pull]
	rebase = true
[rebase]
	autoStash = true
[merge]
	tool = vscode
[mergetool "vscode"]
	cmd = code --wait $MERGED
[diff]
	tool = vscode
[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE
[oh-my-zsh]
	hide-status = 1
	hide-dirty = 1
[push]
	autoSetupRemote = true
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[credential]
	# todo: macos specific, switch template based on OS
	helper = osxkeychain
[pager]
	branch = false
[alias]
	# Show the log as a graph
	graph = log --all --decorate --oneline --graph
	
	# Show the git log in a compact form with datetime, author, message, ref names 
	logc = log --format='%C(auto)%h %ai (%al) %d %s'

	# Save current state as a stash with an optional message from args
	save = "!f() { \
		msg=\"$*\"; \
		git stash push --include-untracked -m \"$msg\"; \
		git stash apply; \
	}; f"

	# Pretty print the diff using bat as a pager
	diffp = "!f() { \
		git diff --name-only --relative --diff-filter=d | xargs bat --diff; \
	}; f"

	# Checkout
	co = checkout

	# Checkout a new branch
	cb = checkout -b
	
	# Skip changes to a file in the working tree (local ignore)
  skip = "!f(){ git update-index --skip-worktree -- \"$@\"; }; f"

  # Unignore changes to a file in the working tree (remove local ignore)
  unskip = "!f(){ git update-index --no-skip-worktree -- \"$@\"; }; f"

  # List skipped files in the working tree
  skipped = "!f(){ git ls-files -v | awk '/^S /{print substr($0,3)}'; }; f"